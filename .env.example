# Copy to .env and fill in. .env is gitignored.
#
# HuggingFace read token. You must also accept the model licences on HF for:
#   - pyannote/speaker-diarization-community-1
#   - pyannote/segmentation-3.0
# Diarization fails with a 401 until both are accepted on your account.
export HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Language and models (all optional; defaults shown) ---
#
# ASR language, as an ISO 639-1 code. Named WQ_LANG rather than LANG because
# LANG is the POSIX locale variable and is already set in every shell.
#export WQ_LANG=en

# Whisper model size. Unset means each script keeps its own default
# (medium for transcribe.sh and mps_pipeline.py, large-v3 for parallel.sh).
#export WQ_MODEL=large-v3

# wav2vec2 CTC model for forced alignment. Unset means WhisperX picks its own
# default for WQ_LANG -- which exists for ~40 languages but NOT for Tamil (ta)
# or Sinhala (si). Without a model here those languages lose word timestamps,
# and therefore lose speaker labels too.
#   Tamil: Harveenchadha/vakyansh-wav2vec2-tamil-tam-250
#export WQ_ALIGN_MODEL=

# Subtitle font for hard burns only. Helvetica has no Indic glyphs, so a Tamil
# or Sinhala hard burn renders as empty boxes without a font that covers the
# script. Soft mux is unaffected -- the player supplies the font.
#   Tamil, on macOS: "Tamil Sangam MN"  (check with: fc-list : family | grep -i tamil)
#export WQ_FONT=Helvetica

# --- hosted ASR (optional) ---
#
# Only needed for scripts/assemblyai_transcribe.py. Leaving this unset does not
# affect the local pipeline in any way.
#
# PRIVACY: that script uploads recording audio to AssemblyAI. These recordings
# are third-party copyright and contain identifiable speech, and an upload
# cannot be undone. Set this only for a batch you have decided to send.
#export ASSEMBLYAI_API_KEY=

# Override AssemblyAI's default speech model. Their default already includes
# diarization; a wrong identifier fails the request outright, so leave unset
# unless you know the exact model string you want.
#export WQ_AAI_MODEL=
